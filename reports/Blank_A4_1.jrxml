	<parameter name="fullname" class="java.lang.String"/>
	<parameter name="mobile" class="java.lang.String"/>
	<parameter name="email" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="linkedin" class="java.lang.String"/>
	<parameter name="objective" class="java.lang.String"/>
	<parameter name="degree" class="java.lang.String"/>
	<parameter name="college" class="java.lang.String"/>
	<parameter name="cgpa" class="java.lang.String"/>
	<parameter name="duration" class="java.lang.String"/>
	<parameter name="hsc" class="java.lang.String"/>
	<parameter name="sslc" class="java.lang.String"/>
	<parameter name="projects" class="java.lang.String"/>
	<parameter name="area_of_interest" class="java.lang.String"/>
	<parameter name="technical_skills" class="java.lang.String"/>
	<parameter name="programming_languages" class="java.lang.String"/>
	<parameter name="software_tools" class="java.lang.String"/>
	<parameter name="internships" class="java.lang.String"/>
	<parameter name="certifications" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
  rd.id,
  TRIM(CONCAT(IFNULL(rd.fullname, ''))) AS fullname,
  IFNULL(rd.mobile, '') AS mobile,
  IFNULL(rd.email, '') AS email,
  IFNULL(rd.address, '') AS address,
  IFNULL(rd.linkedin, '') AS linkedin,
  IFNULL(rd.objective, '') AS objective,
  IFNULL(rd.degree, '') AS degree,
  IFNULL(rd.college, '') AS college,
  IFNULL(rd.cgpa, '') AS cgpa,
  IFNULL(rd.duration, '') AS duration,
  IFNULL(rd.hsc, '') AS hsc,
  IFNULL(rd.sslc, '') AS sslc,
  IFNULL(rd.projects, '') AS projects,
  IFNULL(rd.area_of_interest, '') AS area_of_interest,
  IFNULL(rd.technical_skills, '') AS technical_skills,
  IFNULL(rd.programming_languages, '') AS programming_languages,
  IFNULL(rd.software_tools, '') AS software_tools,
  IFNULL(rd.internships, '') AS internships,
  IFNULL(rd.certifications, '') AS certifications
FROM resume_db.resume_details rd
WHERE rd.fullname = $P{fullname};
]]></query>
